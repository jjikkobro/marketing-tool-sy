{
  "name": "content-studio",
  "private": true,
  "description": "TikTok·Instagram 콘텐츠 수집 에이전트: 실패·누락·중복 기록, MCP 도구 공개 (삼양라운드스퀘어 지원 포트폴리오)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "demo": "npm run demo -w @studio/collector",
    "demo:fail": "npm run demo:fail -w @studio/collector",
    "demo:browser": "npm run cli -w @studio/collector -- demo --scenario browser",
    "snapshot": "npm run cli -w @studio/collector -- demo --scenario agent && npm run cli -w @studio/collector -- export --scenario agent --out ../web/public/data",
    "mcp": "npm run mcp -w @studio/collector",
    "dev": "npm run dev -w @studio/web",
    "build": "npm run build -w @studio/web",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "check:leaks": "node scripts/check-leaks.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "demo:agent": "npm run cli -w @studio/collector -- demo --scenario agent",
    "dev:live": "node scripts/dev-live.mjs",
    "agent": "npm run agent -w @studio/collector --"
  },
  "devDependencies": {
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1"
  }
}
